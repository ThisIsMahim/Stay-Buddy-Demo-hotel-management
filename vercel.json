{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/((?!api).*)*",
      "destination": {
        "service": "frontend",
        "path": "index.html"
      }
    }
  ]
}
